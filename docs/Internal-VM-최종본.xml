<!--
================================================================================
  Internal VM (Windows 11 25H2) - 저지연 튜닝 최종본
  ──────────────────────────────────────────────────────────────────────────────
  기반        : 기존 Internal 도메인 XML
  반영 사항   : P2 (저지연 features)
                P3 (memballoon none, discard unmap, vhost-net)
                P4 (입력/미사용 PCI 정리)
  배제 사항   : P1 비디오 변경 (QXL 유지) — 호스트에서 QXL 지원되는 환경 가정
                hugepages 설정 (호스트 hugepages 미할당 환경 가정)
  주의        :
   1) 적용 전 백업 필수
        virsh dumpxml Internal > ~/Internal.xml.bak.$(date +%F)
   2) 적용 명령
        virsh shutdown Internal
        virsh define ~/Internal-final.xml
        virsh start Internal
   3) 호스트 측 권장 점검 (해당 시)
        - KSM 비활성
            systemctl disable --now ksm ksmtuned
        - CPU governor (전원 연결 시)
            cpupower frequency-set -g performance
================================================================================
-->
<domain type='kvm'>

  <!-- ============================================================ -->
  <!--  기본 식별                                                    -->
  <!-- ============================================================ -->
  <name>Internal</name>
  <uuid>507277c8-9f20-4ea1-bb69-64f0001e5943</uuid>

  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://microsoft.com/win/11"/>
    </libosinfo:libosinfo>
  </metadata>

  <!-- ============================================================ -->
  <!--  메모리 (16 GiB)                                              -->
  <!-- ============================================================ -->
  <!--
    hugepages / memoryBacking 미사용.
    필요 시 추후 추가 (호스트에 nr_hugepages 사전 할당 필요).
  -->
  <memory unit='KiB'>16777216</memory>
  <currentMemory unit='KiB'>16777216</currentMemory>

  <!-- ============================================================ -->
  <!--  vCPU                                                         -->
  <!-- ============================================================ -->
  <!--
    placement='static' : 정적 배치. 노트북 환경 특성상 핀닝은 미적용.
    호스트 코어 수 대비 12 vCPU 적정성은 별도 검토 항목.
  -->
  <vcpu placement='static'>12</vcpu>

  <!-- 디스크 I/O 전용 스레드 2개 (vCPU와 분리되어 latency 안정화) -->
  <iothreads>2</iothreads>

  <resource>
    <partition>/machine</partition>
  </resource>

  <sysinfo type='smbios'>
    <system>
      <entry name='serial'>6DG59FBX900087T</entry>
    </system>
  </sysinfo>

  <!-- ============================================================ -->
  <!--  OS / UEFI / Secure Boot                                      -->
  <!-- ============================================================ -->
  <os>
    <type arch='x86_64' machine='pc-q35-7.2'>hvm</type>
    <loader readonly='yes' secure='yes' type='pflash'>/usr/share/OVMF/OVMF_CODE_4M.ms.fd</loader>
    <nvram template='/usr/share/OVMF/OVMF_VARS_4M.ms.fd'>/var/lib/libvirt/qemu/nvram/Int_VARS.fd</nvram>
    <boot dev='hd'/>
    <smbios mode='sysinfo'/>
  </os>

  <!-- ============================================================ -->
  <!--  CPU 기능 / 가상화 힌트 (저지연 핵심)                          -->
  <!-- ============================================================ -->
  <features>
    <acpi/>
    <apic/>

    <!--
      ioapic driver='kvm'
        : I/O APIC을 KVM 커널 모듈 내에서 직접 에뮬레이션.
          QEMU 사용자 공간 왕복 제거 → 인터럽트 지연 ↓
    -->
    <ioapic driver='kvm'/>

    <!--
      Hyper-V enlightenments
        : Windows 게스트가 자신이 VM임을 인지하고 최적화된 동기화/
          타이머/IPI 메커니즘을 사용하도록 함. Win 게스트엔 사실상 필수.
    -->
    <hyperv mode='custom'>
      <relaxed state='on'/>                        <!-- BSOD 0x101 회피 -->
      <vapic state='on'/>                          <!-- 가상 APIC -->
      <spinlocks state='on' retries='8191'/>       <!-- spinlock yield 힌트 -->
      <vpindex state='on'/>                        <!-- vCPU 인덱스 노출 -->
      <synic state='on'/>                          <!-- 합성 인터럽트 컨트롤러 -->
      <stimer state='on'/>                         <!-- 합성 타이머 -->
      <tlbflush state='on'/>                       <!-- TLB flush IPI 가속 -->
      <ipi state='on'/>                            <!-- IPI 가속 -->
      <frequencies state='on'/>                    <!-- TSC/APIC 주파수 노출 -->
      <reset state='on'/>                          <!-- 깔끔한 리셋 -->
    </hyperv>

    <!--
      KVM 힌트
        hidden       : 게스트 OS에 KVM 정체 숨김 (VM 거부 SW 우회)
        poll-control : 인터럽트 폴링 제어로 latency ↓
    -->
    <kvm>
      <hidden state='on'/>
      <poll-control state='on'/>
    </kvm>

    <vmport state='off'/>      <!-- VMware 호환 포트 비활성 -->
    <smm state='on'/>          <!-- SMM (Secure Boot 동작) -->
  </features>

  <!-- ============================================================ -->
  <!--  CPU 모델                                                     -->
  <!-- ============================================================ -->
  <!--
    host-passthrough : 호스트 CPU 기능 그대로 노출 (성능 최강)
    migratable=off   : 라이브 마이그레이션 포기, 대신 전 기능 사용
    cache passthrough: 게스트 OS가 호스트 캐시 토폴로지를 인식
    invtsc           : 안정적 TSC → 게스트 시간 측정 jitter ↓
  -->
  <cpu mode='host-passthrough' check='none' migratable='off'>
    <topology sockets='1' dies='1' cores='12' threads='1'/>
    <cache mode='passthrough'/>
    <feature policy='require' name='invtsc'/>
  </cpu>

  <!-- ============================================================ -->
  <!--  시계 / 타이머                                                -->
  <!-- ============================================================ -->
  <!--
    localtime         : Windows 게스트 시계 정책
    hpet present='no' : Win에 불필요, 충돌 회피
    hypervclock       : Hyper-V 기반 시계 (Win 권장)
    tsc native        : 가능한 경우 TSC를 가공 없이 노출 → 시간 jitter ↓
  -->
  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
    <timer name='tsc' present='yes' mode='native'/>
  </clock>

  <!-- ============================================================ -->
  <!--  라이프사이클 / 전원                                          -->
  <!-- ============================================================ -->
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>

  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>

  <!-- ============================================================ -->
  <!--  디바이스                                                     -->
  <!-- ============================================================ -->
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  디스크 : virtio-blk + iothread + multi-queue + TRIM        -->
    <!-- ────────────────────────────────────────────────────────── -->
    <!--
      cache='none'         : 호스트 page cache 우회 (저지연 정석)
      io='native'          : Linux native AIO
      discard='unmap'      : 게스트 TRIM이 호스트 qcow2 축소까지 전파
                             (SSD 수명 ↑, 디스크 공간 ↑)
      iothread='1'         : vCPU와 분리된 I/O 스레드
      queues='8'           : virtio multi-queue (12 vCPU에 균형)
      detect_zeroes='off'  : 쓰기 시 0 감지 비활성 (CPU 절약)
    -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='none' io='native'
              discard='unmap' iothread='1' detect_zeroes='off' queues='8'/>
      <source file='/var/lib/libvirt/images/Internal.qcow2'/>
      <backingStore type='file'>
        <format type='qcow2'/>
        <source file='/var/lib/libvirt/images/nst-win11-base.qcow2'/>
        <backingStore/>
      </backingStore>
      <target dev='vda' bus='virtio'/>
      <address type='pci' domain='0x0000' bus='0x05' slot='0x00' function='0x0'/>
    </disk>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  USB 컨트롤러 (xHCI, USB 3.x)                               -->
    <!-- ────────────────────────────────────────────────────────── -->
    <controller type='usb' index='0' model='qemu-xhci' ports='15'>
      <address type='pci' domain='0x0000' bus='0x03' slot='0x00' function='0x0'/>
    </controller>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  PCIe 토폴로지 : root + 핫플러그용 root-port                 -->
    <!--  (참고) pcie-to-pci-bridge / pci-bridge 4개는 제거함         -->
    <!--         미사용 PCI 슬롯 정리로 XML 간결화                    -->
    <!-- ────────────────────────────────────────────────────────── -->
    <controller type='pci' index='0' model='pcie-root'/>

    <controller type='pci' index='1' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='1' port='0x10'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x0' multifunction='on'/>
    </controller>
    <controller type='pci' index='2' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='2' port='0x11'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x1'/>
    </controller>
    <controller type='pci' index='3' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='3' port='0x12'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x2'/>
    </controller>
    <controller type='pci' index='4' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='4' port='0x13'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x3'/>
    </controller>
    <controller type='pci' index='5' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='5' port='0x14'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x4'/>
    </controller>
    <controller type='pci' index='6' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='6' port='0x15'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x5'/>
    </controller>
    <controller type='pci' index='7' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='7' port='0x16'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x6'/>
    </controller>
    <controller type='pci' index='8' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='8' port='0x17'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x7'/>
    </controller>
    <controller type='pci' index='9' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='9' port='0x18'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x03' function='0x0' multifunction='on'/>
    </controller>
    <controller type='pci' index='10' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='10' port='0x19'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x03' function='0x1'/>
    </controller>
    <controller type='pci' index='11' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='11' port='0x1a'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x03' function='0x2'/>
    </controller>

    <!-- SATA 컨트롤러 (q35 기본). CDROM 추가/제거 시 필요. -->
    <controller type='sata' index='0'>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x1f' function='0x2'/>
    </controller>

    <!-- virtio-serial : guest-agent, SPICE 채널용 -->
    <controller type='virtio-serial' index='0'>
      <address type='pci' domain='0x0000' bus='0x04' slot='0x00' function='0x0'/>
    </controller>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  네트워크 : virtio-net + vhost-net 가속 + multi-queue        -->
    <!-- ────────────────────────────────────────────────────────── -->
    <!--
      driver name='vhost' : 패킷 처리 커널 오프로드 (CPU↓, latency↓)
      queues='4'          : multi-queue (NIC 부하 분산)
      ※ Windows 게스트는 게스트 측에서 NIC 다중큐 활성 옵션도 켤 것.
    -->
    <interface type='network'>
      <mac address='12:a3:62:b1:d2:b2'/>
      <source network='InternalNet' bridge='InternalNet'/>
      <target dev='vnet0'/>
      <model type='virtio'/>
      <driver name='vhost' queues='4'/>
      <address type='pci' domain='0x0000' bus='0x02' slot='0x00' function='0x0'/>
    </interface>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  시리얼/콘솔 (디버깅용, 영향 없음)                            -->
    <!-- ────────────────────────────────────────────────────────── -->
    <serial type='pty'>
      <target type='isa-serial' port='0'>
        <model name='isa-serial'/>
      </target>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  SPICE 채널 (클립보드, 게스트 에이전트)                       -->
    <!-- ────────────────────────────────────────────────────────── -->
    <channel type='spicevmc'>
      <target type='virtio' name='com.redhat.spice.0'/>
      <address type='virtio-serial' controller='0' bus='0' port='1'/>
    </channel>

    <channel type='unix'>
      <source mode='bind' path='/var/lib/libvirt/qemu/channel/target/domain-1-Internal/org.qemu.guest_agent.0'/>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
      <address type='virtio-serial' controller='0' bus='0' port='2'/>
    </channel>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  입력 디바이스 (중복 제거)                                    -->
    <!--   유지 : USB tablet (절대좌표, SPICE 일치)                    -->
    <!--          PS/2 keyboard (기본)                                  -->
    <!--   제거 : PS/2 mouse, virtio mouse, virtio keyboard            -->
    <!-- ────────────────────────────────────────────────────────── -->
    <input type='tablet' bus='usb'>
      <address type='usb' bus='0' port='1'/>
    </input>
    <input type='keyboard' bus='ps2'/>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  TPM 2.0 (Win11 필수)                                         -->
    <!-- ────────────────────────────────────────────────────────── -->
    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  그래픽 : SPICE (127.0.0.1만 listen, 외부 차단)               -->
    <!-- ────────────────────────────────────────────────────────── -->
    <graphics type='spice' port='5900' autoport='no' listen='127.0.0.1'>
      <listen type='address' address='127.0.0.1'/>
      <image compression='off'/>
      <clipboard copypaste='yes'/>
    </graphics>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  사운드 (Intel HDA 호환)                                      -->
    <!-- ────────────────────────────────────────────────────────── -->
    <sound model='ich9'>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x1b' function='0x0'/>
    </sound>
    <audio id='1' type='spice'/>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  비디오 : QXL × 3 (멀티 모니터, 기존 유지)                    -->
    <!-- ────────────────────────────────────────────────────────── -->
    <!--
      ※ 본 XML은 호스트 QEMU 빌드에 QXL device가 포함된 환경 대상.
        (다른 호스트에서 미지원 오류 발생 시 virtio-gpu로 교체 필요)
    -->
    <video>
      <model type='qxl' ram='65536' vram='65536' vram64='65536'
             vgamem='32768' heads='1' primary='yes'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x01' function='0x0'/>
    </video>
    <video>
      <model type='qxl' ram='65536' vram='65536' vram64='65536'
             vgamem='32768' heads='2'/>
      <address type='pci' domain='0x0000' bus='0x10' slot='0x01' function='0x0'/>
    </video>
    <video>
      <model type='qxl' ram='65536' vram='65536' vram64='65536'
             vgamem='32768' heads='3'/>
      <address type='pci' domain='0x0000' bus='0x10' slot='0x02' function='0x0'/>
    </video>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  SPICE USB 리다이렉션 (6개 슬롯, 기존 유지)                  -->
    <!-- ────────────────────────────────────────────────────────── -->
    <redirdev bus='usb' type='spicevmc'>
      <address type='usb' bus='0' port='2'/>
    </redirdev>
    <redirdev bus='usb' type='spicevmc'>
      <address type='usb' bus='0' port='3'/>
    </redirdev>
    <redirdev bus='usb' type='spicevmc'>
      <address type='usb' bus='0' port='4'/>
    </redirdev>
    <redirdev bus='usb' type='spicevmc'>
      <address type='usb' bus='0' port='5'/>
    </redirdev>
    <redirdev bus='usb' type='spicevmc'>
      <address type='usb' bus='0' port='6'/>
    </redirdev>
    <redirdev bus='usb' type='spicevmc'>
      <address type='usb' bus='0' port='7'/>
    </redirdev>

    <!-- USB hub(0x08)은 차단, 나머지 허용 -->
    <redirfilter>
      <usbdev class='0x08' allow='no'/>
      <usbdev allow='yes'/>
    </redirfilter>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  Watchdog (게스트 hang 시 reset)                              -->
    <!-- ────────────────────────────────────────────────────────── -->
    <watchdog model='i6300esb' action='reset'>
      <address type='pci' domain='0x0000' bus='0x07' slot='0x00' function='0x0'/>
    </watchdog>

    <!-- ────────────────────────────────────────────────────────── -->
    <!--  메모리 벌룬 비활성 (저지연 우선)                              -->
    <!--   - 벌룬 동작은 jitter 유발 가능                              -->
    <!--   - 노트북에서 메모리 동적 회수 실효성 낮음                   -->
    <!-- ────────────────────────────────────────────────────────── -->
    <memballoon model='none'/>

  </devices>

  <!-- ============================================================ -->
  <!--  SELinux/DAC 라벨 (libvirt 자동 관리)                          -->
  <!-- ============================================================ -->
  <seclabel type='dynamic' model='dac' relabel='yes'>
    <label>+64055:+64055</label>
    <imagelabel>+64055:+64055</imagelabel>
  </seclabel>
</domain>
